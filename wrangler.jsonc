{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "shiptalkers-preview",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "shiptalkers-preview" }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shiptalkers-preview",
			"database_id": "174929aa-2310-4d80-89fc-1f26ae2beea8",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{ "binding": "CACHE", "id": "9e4da5271b68429db3b2171b85020a59" }
	]
}
